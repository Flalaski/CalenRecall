{
  "compilerOptions": {
    "target": "ES2020",
    "module": "nodenext",
    "lib": ["ES2020"],
    "outDir": "./",
    "rootDir": "..",
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "strict": true
  },
  "include": [
    "test-calendar-accuracy.ts",
    "verify-epochs.ts",
    "verify-chinese-calendar.ts",
    "../src/utils/calendars/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "../src/**/*.tsx",
    "../src/components/**/*",
    "../src/contexts/**/*",
    "../src/services/**/*",
    "../src/main.tsx",
    "../src/preferences.tsx",
    "../src/App.tsx"
  ]
}

